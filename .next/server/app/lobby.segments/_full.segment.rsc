13:["$","main",null,{"className":"min-h-screen","children":[["$","header",null,{"className":"exam-topbar","children":["$","div",null,{"className":"exam-shell py-6","children":[["$","p",null,{"className":"text-[11px] tracking-[0.3em] text-slate-300","children":"EXAM AND LEARN"}],["$","h1",null,{"className":"mt-1 text-2xl font-bold","children":"線上測驗系統"}],["$","p",null,{"className":"mt-1 text-sm text-slate-300","children":"系統已接收你的自組卷，確認後即可開始作答"}]]}]}],["$","div",null,{"className":"exam-shell py-6","children":["$","$L25",null,{"exams":[{"id":"assigned-demo","title":"計算機概論 模擬測驗","subtitle":"公職考試 ・ 50 題 ・ 60 分鐘","durationSec":3600,"questions":[{"id":"assigned-01","type":"single","prompt":"計算機五大單元中，負責執行算術與邏輯運算的是下列哪一個單元？","points":2,"options":[{"id":"A","text":"控制單元"},{"id":"B","text":"算術邏輯單元"},{"id":"C","text":"記憶單元"},{"id":"D","text":"輸入輸出單元"}]},{"id":"assigned-02","type":"single","prompt":"1 個位元組（Byte）等於多少個位元（Bit）？","points":2,"options":[{"id":"A","text":"4 個"},{"id":"B","text":"8 個"},{"id":"C","text":"16 個"},{"id":"D","text":"32 個"}]},{"id":"assigned-03","type":"single","prompt":"二進位數 1011 的十進位值為何？","points":2,"options":[{"id":"A","text":"9"},{"id":"B","text":"10"},{"id":"C","text":"11"},{"id":"D","text":"13"}]},{"id":"assigned-04","type":"single","prompt":"十六進位數 1A 的十進位值為何？","points":2,"options":[{"id":"A","text":"24"},{"id":"B","text":"25"},{"id":"C","text":"26"},{"id":"D","text":"27"}]},{"id":"assigned-05","type":"single","prompt":"快取記憶體（Cache）的主要作用為何？","points":2,"options":[{"id":"A","text":"增加硬碟容量"},{"id":"B","text":"加快 CPU 存取常用資料的速度"},{"id":"C","text":"負責網路路由"},{"id":"D","text":"永久保存資料"}]},{"id":"assigned-06","type":"single","prompt":"下列哪一種記憶體屬於揮發性記憶體？","points":2,"options":[{"id":"A","text":"ROM"},{"id":"B","text":"DRAM"},{"id":"C","text":"SSD"},{"id":"D","text":"隨身碟"}]},{"id":"assigned-07","type":"single","prompt":"電腦關機後，下列哪一種記憶體仍會保留資料？","points":2,"options":[{"id":"A","text":"RAM"},{"id":"B","text":"暫存器"},{"id":"C","text":"ROM"},{"id":"D","text":"快取記憶體"}]},{"id":"assigned-08","type":"single","prompt":"電腦匯流排（Bus）的主要功能為何？","points":2,"options":[{"id":"A","text":"連接各單元並傳輸資料"},{"id":"B","text":"儲存使用者檔案"},{"id":"C","text":"執行防毒掃描"},{"id":"D","text":"提供螢幕畫面"}]},{"id":"assigned-09","type":"single","prompt":"下列哪一項屬於作業系統的主要功能？","points":2,"options":[{"id":"A","text":"文書編輯"},{"id":"B","text":"記憶體與行程管理"},{"id":"C","text":"網頁瀏覽"},{"id":"D","text":"影像剪輯"}]},{"id":"assigned-10","type":"single","prompt":"作業系統中的分頁（Paging）機制主要用來解決什麼問題？","points":2,"options":[{"id":"A","text":"外部碎片"},{"id":"B","text":"CPU 過熱"},{"id":"C","text":"網路壅塞"},{"id":"D","text":"螢幕解析度不足"}]},{"id":"assigned-11","type":"single","prompt":"虛擬記憶體（Virtual Memory）的主要作用為何？","points":2,"options":[{"id":"A","text":"讓程式可使用的位址空間大於實體記憶體"},{"id":"B","text":"加快印表機列印速度"},{"id":"C","text":"壓縮圖片檔案"},{"id":"D","text":"加密網路封包"}]},{"id":"assigned-12","type":"single","prompt":"下列哪一項「不是」發生死結（Deadlock）的必要條件？","points":2,"options":[{"id":"A","text":"互斥（Mutual Exclusion）"},{"id":"B","text":"持有並等待（Hold and Wait）"},{"id":"C","text":"可剝奪（Preemption）"},{"id":"D","text":"循環等待（Circular Wait）"}]},{"id":"assigned-13","type":"single","prompt":"Round Robin 排程演算法的主要特性為何？","points":2,"options":[{"id":"A","text":"依固定時間片段輪流執行"},{"id":"B","text":"先來先服務"},{"id":"C","text":"依優先權高低執行"},{"id":"D","text":"最短工作優先執行"}]},{"id":"assigned-14","type":"single","prompt":"同一行程（Process）中的多個執行緒（Thread）通常共用下列哪一項資源？","points":2,"options":[{"id":"A","text":"堆疊（Stack）"},{"id":"B","text":"程式計數器（Program Counter）"},{"id":"C","text":"堆積（Heap）與全域變數"},{"id":"D","text":"暫存器（Register）"}]},{"id":"assigned-15","type":"single","prompt":"中斷（Interrupt）機制的主要用途為何？","points":2,"options":[{"id":"A","text":"通知 CPU 處理需要立即反應的事件"},{"id":"B","text":"增加記憶體容量"},{"id":"C","text":"壓縮資料檔案"},{"id":"D","text":"備份作業系統"}]},{"id":"assigned-16","type":"single","prompt":"檔案系統（File System）主要負責下列哪一項工作？","points":2,"options":[{"id":"A","text":"管理檔案與目錄"},{"id":"B","text":"執行病毒掃描"},{"id":"C","text":"提供螢幕畫面"},{"id":"D","text":"控制印表機墨水"}]},{"id":"assigned-17","type":"single","prompt":"TCP 協定的主要特性為何？","points":2,"options":[{"id":"A","text":"可靠且具連線導向"},{"id":"B","text":"不可靠且不保證送達"},{"id":"C","text":"只支援廣播"},{"id":"D","text":"不需要任何確認機制"}]},{"id":"assigned-18","type":"single","prompt":"IPv4 位址的長度為多少位元？","points":2,"options":[{"id":"A","text":"16 位元"},{"id":"B","text":"32 位元"},{"id":"C","text":"64 位元"},{"id":"D","text":"128 位元"}]},{"id":"assigned-19","type":"single","prompt":"DNS 的主要功能為何？","points":2,"options":[{"id":"A","text":"將網域名稱轉換為 IP 位址"},{"id":"B","text":"壓縮網路封包"},{"id":"C","text":"加密電子郵件"},{"id":"D","text":"分配實體網路卡"}]},{"id":"assigned-20","type":"single","prompt":"HTTP 協定的預設通訊埠為何？","points":2,"options":[{"id":"A","text":"21"},{"id":"B","text":"25"},{"id":"C","text":"80"},{"id":"D","text":"443"}]},{"id":"assigned-21","type":"single","prompt":"OSI 七層模型中，負責選擇路由與轉送封包的是哪一層？","points":2,"options":[{"id":"A","text":"實體層"},{"id":"B","text":"資料鏈結層"},{"id":"C","text":"網路層"},{"id":"D","text":"應用層"}]},{"id":"assigned-22","type":"single","prompt":"路由器（Router）的主要功能為何？","points":2,"options":[{"id":"A","text":"選擇路徑並轉送封包"},{"id":"B","text":"放大網路訊號"},{"id":"C","text":"儲存網頁內容"},{"id":"D","text":"過濾垃圾郵件"}]},{"id":"assigned-23","type":"single","prompt":"防火牆（Firewall）的主要用途為何？","points":2,"options":[{"id":"A","text":"控制進出網路的流量"},{"id":"B","text":"增加硬碟容量"},{"id":"C","text":"提升螢幕解析度"},{"id":"D","text":"備份使用者資料"}]},{"id":"assigned-24","type":"single","prompt":"對稱式加密（Symmetric Encryption）的特性為何？","points":2,"options":[{"id":"A","text":"加密與解密使用同一把金鑰"},{"id":"B","text":"使用公開金鑰與私密金鑰"},{"id":"C","text":"加密後無法還原"},{"id":"D","text":"只能用於數位簽章"}]},{"id":"assigned-25","type":"single","prompt":"數位簽章（Digital Signature）的主要目的為何？","points":2,"options":[{"id":"A","text":"驗證身分與資料完整性"},{"id":"B","text":"壓縮傳輸檔案"},{"id":"C","text":"增加網路頻寬"},{"id":"D","text":"備份資料庫"}]},{"id":"assigned-26","type":"single","prompt":"下列哪一項屬於惡意程式？","points":2,"options":[{"id":"A","text":"作業系統"},{"id":"B","text":"編譯器"},{"id":"C","text":"勒索軟體"},{"id":"D","text":"網頁瀏覽器"}]},{"id":"assigned-27","type":"single","prompt":"SQL 的主要用途為何？","points":2,"options":[{"id":"A","text":"查詢與操作關聯式資料庫"},{"id":"B","text":"設計網頁版面"},{"id":"C","text":"壓縮影片檔案"},{"id":"D","text":"管理印表機"}]},{"id":"assigned-28","type":"single","prompt":"關聯式資料表中，主鍵（Primary Key）的特性為何？","points":2,"options":[{"id":"A","text":"唯一且不可為空"},{"id":"B","text":"可以重複"},{"id":"C","text":"必須是文字型別"},{"id":"D","text":"允許空值"}]},{"id":"assigned-29","type":"single","prompt":"資料庫正規化（Normalization）的主要目的為何？","points":2,"options":[{"id":"A","text":"減少資料重複與更新異常"},{"id":"B","text":"增加資料重複以提升速度"},{"id":"C","text":"提高硬體運算速度"},{"id":"D","text":"將資料加密"}]},{"id":"assigned-30","type":"single","prompt":"關聯式資料庫主要以何種方式表示資料與關聯？","points":2,"options":[{"id":"A","text":"資料表"},{"id":"B","text":"圖片"},{"id":"C","text":"音訊"},{"id":"D","text":"影片"}]},{"id":"assigned-31","type":"single","prompt":"二分搜尋法（Binary Search）的平均時間複雜度為何？","points":2,"options":[{"id":"A","text":"O(1)"},{"id":"B","text":"O(log n)"},{"id":"C","text":"O(n)"},{"id":"D","text":"O(n²)"}]},{"id":"assigned-32","type":"single","prompt":"穩定排序（Stable Sort）的特性為何？","points":2,"options":[{"id":"A","text":"相同鍵值元素的相對順序維持不變"},{"id":"B","text":"一定是執行最快的排序"},{"id":"C","text":"不需要進行比較"},{"id":"D","text":"只能用於數字資料"}]},{"id":"assigned-33","type":"single","prompt":"堆疊（Stack）的存取順序為何？","points":2,"options":[{"id":"A","text":"先進先出（FIFO）"},{"id":"B","text":"後進先出（LIFO）"},{"id":"C","text":"隨機存取"},{"id":"D","text":"依優先權存取"}]},{"id":"assigned-34","type":"single","prompt":"佇列（Queue）的存取順序為何？","points":2,"options":[{"id":"A","text":"後進先出（LIFO）"},{"id":"B","text":"先進先出（FIFO）"},{"id":"C","text":"隨機存取"},{"id":"D","text":"依索引大小存取"}]},{"id":"assigned-35","type":"single","prompt":"在單向鏈結串列（Singly Linked List）的頭部插入新節點，時間複雜度為何？","points":2,"options":[{"id":"A","text":"O(1)"},{"id":"B","text":"O(log n)"},{"id":"C","text":"O(n)"},{"id":"D","text":"O(n log n)"}]},{"id":"assigned-36","type":"single","prompt":"雜湊表（Hash Table）在理想情況下的平均搜尋時間複雜度為何？","points":2,"options":[{"id":"A","text":"O(1)"},{"id":"B","text":"O(log n)"},{"id":"C","text":"O(n)"},{"id":"D","text":"O(n²)"}]},{"id":"assigned-37","type":"single","prompt":"撰寫遞迴函式時，必須具備下列哪一項要素？","points":2,"options":[{"id":"A","text":"終止條件"},{"id":"B","text":"無窮迴圈"},{"id":"C","text":"全域變數"},{"id":"D","text":"多執行緒"}]},{"id":"assigned-38","type":"single","prompt":"編譯器（Compiler）與直譯器（Interpreter）的主要差異為何？","points":2,"options":[{"id":"A","text":"編譯器先將程式轉為機器碼再執行"},{"id":"B","text":"直譯器一定執行較快"},{"id":"C","text":"編譯器不能檢查語法錯誤"},{"id":"D","text":"直譯器只能處理硬體電路"}]},{"id":"assigned-39","type":"single","prompt":"程式語言中變數的資料型別主要決定什麼？","points":2,"options":[{"id":"A","text":"可儲存的值範圍與可進行的操作"},{"id":"B","text":"螢幕顯示顏色"},{"id":"C","text":"網路傳輸速度"},{"id":"D","text":"檔案名稱長度"}]},{"id":"assigned-40","type":"single","prompt":"物件導向中的「封裝」（Encapsulation）是指什麼？","points":2,"options":[{"id":"A","text":"隱藏內部實作並提供公開介面"},{"id":"B","text":"複製多個相同物件"},{"id":"C","text":"刪除不需要的類別"},{"id":"D","text":"將所有變數設為公開"}]},{"id":"assigned-41","type":"single","prompt":"雲端運算的 IaaS（Infrastructure as a Service）主要提供什麼？","points":2,"options":[{"id":"A","text":"虛擬機器與儲存等基礎運算資源"},{"id":"B","text":"只能提供網頁瀏覽器"},{"id":"C","text":"只能提供文書軟體"},{"id":"D","text":"只能提供電子郵件"}]},{"id":"assigned-42","type":"single","prompt":"大數據常以 3V 描述，下列哪一項「不是」3V 的內容？","points":2,"options":[{"id":"A","text":"資料量（Volume）"},{"id":"B","text":"資料速度（Velocity）"},{"id":"C","text":"資料多樣性（Variety）"},{"id":"D","text":"資料顏色（Color）"}]},{"id":"assigned-43","type":"single","prompt":"機器學習模型訓練通常需要下列哪一組要素？","points":2,"options":[{"id":"A","text":"資料與演算法"},{"id":"B","text":"只有螢幕與鍵盤"},{"id":"C","text":"只有印表機"},{"id":"D","text":"只有網路線"}]},{"id":"assigned-44","type":"single","prompt":"物聯網（IoT）的核心概念為何？","points":2,"options":[{"id":"A","text":"讓各種裝置連網並交換資料"},{"id":"B","text":"只能玩線上遊戲"},{"id":"C","text":"只能使用離線電腦"},{"id":"D","text":"只能處理文書排版"}]},{"id":"assigned-45","type":"single","prompt":"區塊鏈（Blockchain）的主要特性為何？","points":2,"options":[{"id":"A","text":"分散式帳本且資料難以竄改"},{"id":"B","text":"單一集中式資料庫"},{"id":"C","text":"只能儲存圖片"},{"id":"D","text":"保證完全匿名"}]},{"id":"assigned-46","type":"single","prompt":"數位憑證（Digital Certificate）通常由誰簽發？","points":2,"options":[{"id":"A","text":"憑證授權中心（CA）"},{"id":"B","text":"使用者本人"},{"id":"C","text":"網際網路服務供應商（ISP）"},{"id":"D","text":"作業系統廠商"}]},{"id":"assigned-47","type":"single","prompt":"系統儲存使用者密碼時，通常會採用下列哪一種方式？","points":2,"options":[{"id":"A","text":"雜湊加鹽（Hashing with Salt）"},{"id":"B","text":"直接明文儲存"},{"id":"C","text":"壓縮後儲存"},{"id":"D","text":"轉成圖片儲存"}]},{"id":"assigned-48","type":"single","prompt":"備份 3-2-1 原則中的「1」代表什麼？","points":2,"options":[{"id":"A","text":"至少一份異地備份"},{"id":"B","text":"只需要一份密碼"},{"id":"C","text":"只需要一台電腦"},{"id":"D","text":"只能有一位使用者"}]},{"id":"assigned-49","type":"single","prompt":"個人資料保護法的主要目的為何？","points":2,"options":[{"id":"A","text":"保護個人資料與隱私"},{"id":"B","text":"增加政府稅收"},{"id":"C","text":"管制網路速度"},{"id":"D","text":"限制電腦數量"}]},{"id":"assigned-50","type":"single","prompt":"計算機五大單元「不包括」下列哪一項？","points":2,"options":[{"id":"A","text":"輸入單元"},{"id":"B","text":"輸出單元"},{"id":"C","text":"記憶單元"},{"id":"D","text":"通訊單元"}]}]}]}]}]]}]
